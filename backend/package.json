{
  "name": "@nutri-heaven/backend",
  "version": "0.1.0",
  "private": true,
  "description": "Nutri Heaven API — NestJS + TypeScript + Mongoose, catalogue and pricing served from MongoDB",
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "clean": "rm -rf dist",
    "seed": "node dist/seed.js",
    "test": "jest --config ./test/jest-e2e.js",
    "test:watch": "jest --config ./test/jest-e2e.js --watch",
    "infra:up": "docker compose up -d --wait",
    "infra:buckets": "docker compose up object-storage-init",
    "infra:down": "docker compose down",
    "infra:logs": "docker compose logs -f",
    "infra:reset": "docker compose down -v"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.5",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.5",
    "@nestjs/jwt": "^12.0.2",
    "@nestjs/mongoose": "^11.0.4",
    "@nestjs/passport": "^12.0.0",
    "@nestjs/platform-express": "^11.2.5",
    "bcryptjs": "^3.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "mongoose": "^8.24.4",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/testing": "^11.2.5",
    "@types/express": "^5.0.1",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.2",
    "@types/passport-jwt": "^4.0.1",
    "@types/supertest": "^7.2.1",
    "jest": "^29.7.0",
    "mongodb-memory-server": "^11.2.0",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.1",
    "typescript": "~5.9.3"
  }
}
