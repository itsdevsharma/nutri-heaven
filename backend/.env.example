# Copy this file to `.env` to override the development defaults.
#
# `.env` is git-ignored. The values below are the same defaults baked into
# docker-compose.yml, so this file is optional for local development.

# --- MongoDB (single-node replica set, see docker-compose.yml) ---
# Local development needs no credentials: the container binds to 127.0.0.1 with
# no --auth, so the API connects without a username/password. Production uses
# an authenticated managed MongoDB — set the full URI (with credentials) here.
MONGO_PORT=27017
# MONGODB_URI=mongodb://localhost:27017/nutri_heaven?directConnection=true

# --- Redis (also the BullMQ broker) ---
REDIS_PORT=6379
# REDIS_URL=redis://localhost:6379

# --- Object storage (S3 compatible) ---
MINIO_ROOT_USER=nutri
MINIO_ROOT_PASSWORD=nutri_dev_password
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_BUCKET=nutri-media
# S3_ENDPOINT=http://localhost:9000
# S3_REGION=us-east-1
# S3_ACCESS_KEY_ID=nutri
# S3_SECRET_ACCESS_KEY=nutri_dev_password

# --- Cloudinary (production image uploads) ---
# Obtain this from Cloudinary's API Environment Variable section. Keep the
# real value only in the ignored `.env` file or your deployment environment.
# CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>

# --- Backend API (backend) ---
API_PORT=3000
# Comma-separated trusted storefront origins. Production must use HTTPS URLs,
# Keep all local Vite origins here; set the public storefront origin(s) on the
# production API instead.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174
# Admin bootstrap: required by `pnpm seed` to create the first super-admin.
# Use a unique 32+ character JWT secret outside local development.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=dev123456789
JWT_ACCESS_SECRET=replace-with-a-long-random-secret
# Set only during a planned JWT signing-key rollover. The API accepts tokens
# signed by this prior key until the longest token lifetime (currently 7 days)
# has elapsed, then remove it. Never leave a previous key configured forever.
# JWT_ACCESS_SECRET_PREVIOUS=
# Production APIs run behind their host's HTTPS proxy. Required in production
# so Express obtains the real protocol/client IP from trusted proxy headers.
# TRUST_PROXY=true
# Per-process fallback limits. Also configure the same (or stricter) limits at
# your CDN/WAF because this in-memory limiter is not shared across replicas.
# RATE_LIMIT_LOGIN_PER_15_MIN=8
# RATE_LIMIT_PAYMENT_PER_MIN=30
# RATE_LIMIT_WRITE_PER_MIN=90
# RATE_LIMIT_READ_PER_MIN=300
# RATE_LIMIT_ENABLED=true
# Razorpay: use test keys in development and live keys for production.
# Keep secrets in the ignored backend/.env file or your host environment.
# RAZORPAY_KEY_ID=rzp_test_...
# RAZORPAY_KEY_SECRET=...
# Webhook secret must match your Razorpay dashboard webhook configuration.
# RAZORPAY_WEBHOOK_SECRET=...
# NODE_ENV=development
# LOG_LEVEL=debug

# Transactional email (Resend verified sender). Never expose the API key in Vite.
RESEND_API_KEY=
MAIL_FROM=
STOREFRONT_URL=http://localhost:5173

# Full-order return request window, measured from original delivery evidence.
ORDER_RETURN_WINDOW_DAYS=7
