# Local backend. In production, set this to the public backend origin before
# building (for example https://api.your-domain.com). For the Ubuntu/Nginx
# deployment use /api, with deploy/nginx-api.conf included in the HTTPS server.
# An empty production value also defaults to /api.
VITE_API_URL=http://localhost:3000

VITE_SITE_URL=https://nutriheaven.co.in
