# Local backend. In production, set this to the public backend origin before
# building (for example https://api.your-domain.com). An empty value sends API
# requests to the frontend host and requires explicit reverse-proxy API routes;
# /admin/* otherwise collides with the frontend's admin page routes.
VITE_API_URL=http://localhost:3000

VITE_SITE_URL=https://nutri-heaven-topaz.vercel.app
